(* Beginning of Notebook Content *)
Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"fouriezer", "[", 
   RowBox[{"rawData_", ",", "samplingTimeinMilliseconds_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "timeData", ",", "timeSeries", ",", "spec", ",", "dt", ",", "fs", ",", 
      "n", ",", "time", ",", "alpha", ",", "window", ",", "windowData", ",", 
      "windowSpec", ",", "freqs", ",", "fourierPlot", ",", 
      "lowFreqFourierPlot", ",", "longPeriodPlot"}], "}"}], ",", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"timeData", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"samplingTimeinMilliseconds", "*", "i"}], ",", 
          RowBox[{"rawData", "[", 
           RowBox[{"[", 
            RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{
           RowBox[{"Length", "[", "rawData", "]"}], "-", "1"}]}], "}"}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"spec", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"Fourier", "[", "rawData", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"dt", "=", 
      RowBox[{"samplingTimeinMilliseconds", "/", "1000."}]}], 
     RowBox[{"(*", "seconds", "*)"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fs", "=", 
      RowBox[{"1", "/", "dt"}]}], ";", "\n", "     ", 
     RowBox[{"n", "=", 
      RowBox[{"Length", "[", "rawData", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"time", " ", "=", " ", 
      RowBox[{"n", "*", "dt"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"alpha", "=", "0.9"}], ";", "\[IndentingNewLine]", 
     RowBox[{"window", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"alpha", "-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "-", "alpha"}], ")"}], "*", 
           RowBox[{"Cos", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"2", " ", "Pi", " ", "i"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}]}], "]"}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"windowData", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"rawData", "-", 
         RowBox[{"Mean", "[", "rawData", "]"}]}], ")"}], "*", "window"}]}], 
     ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"windowSpec", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{"Fourier", "[", "windowData", "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"freqs", "=", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"fs", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"n", "-", "1"}], ")"}], "/", "n"}]}], ",", 
        RowBox[{"fs", "/", "n"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"timeSeries", "=", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{"timeData", ",", 
        RowBox[{"ImageSize", "\[Rule]", "1200"}], ",", 
        RowBox[{"Frame", "\[Rule]", "True"}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<V(t)\>\"", ",", "None"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Time [ms]\>\"", ",", 
             RowBox[{
              RowBox[{"ToString", "[", "time", "]"}], "<>", "\"\< sec\\n\>\"",
               "<>", 
              RowBox[{"ToString", "[", "fs", "]"}], "<>", 
              "\"\< Hz sampling\>\""}]}], "}"}]}], "}"}]}], ",", 
        RowBox[{"LabelStyle", "\[Rule]", 
         RowBox[{"FontSize", "\[Rule]", "24"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"fourierPlot", "=", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{"Drop", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"freqs", ",", "windowSpec"}], "}"}], "]"}], ",", "25"}], 
         "]"}], ",", 
        RowBox[{"ScalingFunctions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"fs", "/", "2"}]}], "}"}], ",", "All"}], "}"}]}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "1200"}], ",", 
        RowBox[{"Frame", "\[Rule]", "True"}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<F(t)\>\"", ",", "None"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Freq. [Hz]\>\"", ",", 
             RowBox[{
              RowBox[{"ToString", "[", "time", "]"}], "<>", "\"\< sec\\n\>\"",
               "<>", 
              RowBox[{"ToString", "[", "fs", "]"}], "<>", 
              "\"\< Hz sampling\>\""}]}], "}"}]}], "}"}]}], ",", 
        RowBox[{"LabelStyle", "\[Rule]", 
         RowBox[{"FontSize", "\[Rule]", "24"}]}], ",", 
        RowBox[{"GridLines", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{"i", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "0", ",", 
               RowBox[{"fs", "/", "2"}], ",", "10"}], "}"}]}], "]"}], ",", 
           "Automatic"}], "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"lowFreqFourierPlot", "=", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"freqs", ",", "windowSpec"}], "}"}], "]"}], "//", "Rest"}],
         ",", 
        RowBox[{"ScalingFunctions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"fs", "/", "1024"}]}], "}"}], ",", "All"}], "}"}]}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "1200"}], ",", 
        RowBox[{"Frame", "\[Rule]", "True"}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<F(t)\>\"", ",", "None"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Freq. [Hz]\>\"", ",", 
             RowBox[{
              RowBox[{"ToString", "[", "time", "]"}], "<>", "\"\< sec\\n\>\"",
               "<>", 
              RowBox[{"ToString", "[", "fs", "]"}], "<>", 
              "\"\< Hz sampling\>\""}]}], "}"}]}], "}"}]}], ",", 
        RowBox[{"LabelStyle", "\[Rule]", 
         RowBox[{"FontSize", "\[Rule]", "24"}]}], ",", 
        RowBox[{"GridLines", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{"i", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "0", ",", 
               RowBox[{"fs", "/", "256"}], ",", "0.02"}], "}"}]}], "]"}], ",",
            "Automatic"}], "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"longPeriodPlot", "=", 
      RowBox[{"ListLinePlot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"1", "/", "freqs"}], ",", "windowSpec"}], "}"}], "]"}], "//",
          "Rest"}], ",", 
        RowBox[{"ScalingFunctions", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<Log\>\"", ",", "\"\<Log\>\""}], "}"}]}], ",", 
        RowBox[{"PlotRange", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"time", "/", "2"}]}], "}"}], ",", "All"}], "}"}]}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "1200"}], ",", 
        RowBox[{"Frame", "\[Rule]", "True"}], ",", 
        RowBox[{"FrameLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<F(t)\>\"", ",", "None"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Period. [s]\>\"", ",", 
             RowBox[{
              RowBox[{"ToString", "[", "time", "]"}], "<>", "\"\< sec\\n\>\"",
               "<>", 
              RowBox[{"ToString", "[", "fs", "]"}], "<>", 
              "\"\< Hz sampling\>\""}]}], "}"}]}], "}"}]}], ",", 
        RowBox[{"LabelStyle", "\[Rule]", 
         RowBox[{"FontSize", "\[Rule]", "24"}]}], ",", 
        RowBox[{"GridLines", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{"i", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "20", ",", "1"}], "}"}]}], "]"}], 
           ",", "Automatic"}], "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"{", 
       RowBox[{
       "timeSeries", ",", "fourierPlot", ",", "lowFreqFourierPlot", ",", 
        "longPeriodPlot"}], "}"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 InitializationCell->True,
